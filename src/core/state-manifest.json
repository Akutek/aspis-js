{
    "settings": {
        "strictMode": true,
        "debug": true
    },
    "globalStyles": {
        "HIDDEN": "is-hidden",
        "ACTIVE": "is-active",
        "DISABLED": "is-disabled"
    },
    "slices": {
        "app.ui": {
            "initialState": {
                "globalSpinner": false,
                "sidebarExpanded": true
            },
            "config": {
                "styles": {
                    "SPINNER_ACTIVE": "is-active"
                },
                "targets": {
                    "spinner": {
                        "selector": "#global-spinner",
                        "bindClasses": {
                            "globalSpinner": "SPINNER_ACTIVE"
                        }
                    }
                }
            }
        },
        "features.gildeTable": {
            "initialState": {
                "model": null,
                "isLoading": false,
                "isCompact": false
            },
            "config": {
                "styles": {
                    "LOADING": "table-body-shimmer",
                    "COMPACT": "table-layout-compact"
                },
                "targets": {
                    "host": {
                        "selector": ":scope",
                        "bindClasses": {
                            "isCompact": "COMPACT"
                        }
                    },
                    "body": {
                        "selector": "[data-target='table-body']",
                        "bindClasses": {
                            "isLoading": "LOADING"
                        }
                    }
                }
            }
        },
        "features.filter": {
            "initialState": {
                "searchQuery": ""
            },
            "config": {
                "styles": {
                    "HIGHLIGHT": "filter-active-highlight"
                },
                "targets": {
                    "input": {
                        "selector": "input",
                        "bindClasses": {
                            "searchQuery": "HIGHLIGHT"
                        }
                    }
                }
            }
        },
        "features.characterAccordion": {
            "initialState": {
                "activeItemId": null,
                "expanded": false
            },
            "config": {
                "styles": {
                    "OPEN": "accordion-expanded"
                },
                "targets": {
                    "host": {
                        "selector": ":scope",
                        "bindClasses": {
                            "expanded": "OPEN"
                        }
                    }
                }
            }
        },
        "shared.dropdownWowClass": {
            "initialState": {
                "isOpen": false,
                "selectedValue": null
            },
            "config": {
                "styles": {
                    "OPEN": "dropdown-menu-show"
                },
                "targets": {
                    "menu": {
                        "selector": "[data-target='menu']",
                        "bindClasses": {
                            "isOpen": "OPEN"
                        }
                    }
                }
            }
        }
    }
}