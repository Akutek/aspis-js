{
  "name": "aspis-js",
  "version": "1.0.0",
  "description": "Manifestgetriebenes Vanilla-ESM-Frontend. Einmal Boot, danach runCycle: Scan → Plan → Compare → Observer → Compose → Controller → Splice → Factory.",
  "type": "module",
  "license": "MIT",
  "main": "./src/aspis.js",
  "exports": {
    ".": {
      "import": "./src/aspis.js",
      "default": "./src/aspis.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.html",
    ".htaccess",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "./src/entry.js"
  ],
  "scripts": {
    "start": "php -S localhost:8080",
    "test": "vitest --config vitest.config.js --run",
    "test:watch": "vitest --config vitest.config.js",
    "bench": "vitest --config vitest.config.js bench --run"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akutek/aspis-js.git"
  },
  "keywords": [
    "aspis",
    "frontend",
    "manifest",
    "esm"
  ],
  "bugs": {
    "url": "https://github.com/Akutek/aspis-js/issues"
  },
  "homepage": "https://github.com/Akutek/aspis-js#readme"
}
